# Copy this file to .env.local and fill in your key, then restart `npm run dev`.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Any tool-calling capable Groq model, e.g. openai/gpt-oss-120b,
# openai/gpt-oss-20b, llama-3.3-70b-versatile, qwen/qwen3.8-27b.
GROQ_MODEL=qwen/qwen3.8-27b
